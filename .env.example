# Copy this file to .env and replace placeholder values as needed.

# Default provider
PAICLI_PROVIDER=deepseek
PAICLI_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=your_deepseek_api_key

# Generic OpenAI-compatible endpoint (alternative to the provider above)
# PAICLI_PROVIDER=openai-compatible
# PAICLI_MODEL=qwen2.5-coder
# PAICLI_BASE_URL=http://127.0.0.1:11434/v1
# PAICLI_API_KEY=your_api_key

# Provider-specific API keys (uncomment only the one you use)
# PAICLI_QWEN_API_KEY=your_qwen_api_key
# PAICLI_DASHSCOPE_API_KEY=your_dashscope_api_key
# GLM_API_KEY=your_glm_api_key
# STEP_API_KEY=your_step_api_key
# KIMI_API_KEY=your_kimi_api_key
# FREELLMAPI_API_KEY=your_freellmapi_api_key
# XFYUN_API_KEY=your_xfyun_api_key
# AGNES_API_KEY=your_agnes_api_key

# Model behavior
# PAICLI_MAX_TOKENS=16384
# PAICLI_CONTEXT_WINDOW=64000
# PAICLI_TEMPERATURE=0.7
# PAICLI_THINKING_LEVEL=medium
# PAICLI_THINKING_BUDGET=8192

# Interface and safety
# PAICLI_RENDER_MODE=inline
# PAICLI_TYPEWRITER=true
# PAICLI_TYPEWRITER_CPS=80
# PAICLI_TYPEWRITER_MAX_CPS=320
# PAICLI_TYPEWRITER_FPS=30
# PAICLI_HITL=auto
# PAICLI_MCP=true
# PAICLI_SKILL=true
# PAICLI_MEMORY=true

# Runtime HTTP API
# PAICLI_RUNTIME_API_KEY=replace_with_a_strong_random_key

# Workspace checkpoints
# PAICLI_SNAPSHOT_ENABLED=true
# PAICLI_SNAPSHOT_BACKEND=auto
# PAICLI_SNAPSHOT_DIR=~/.paicli/snapshots
# PAICLI_SNAPSHOT_MAX=50
# PAICLI_SNAPSHOT_EXCLUDES=node_modules,target
